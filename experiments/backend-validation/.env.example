# Copy to .env.local (gitignored) and fill in. PLACEHOLDERS ONLY in this file — never
# commit a real value anywhere in this repo (leaked-key precedent: see the credential-scrub
# phase of docs/plans/agents-critical-path/PLAN.md). Values deliberately do NOT imitate
# real key shapes so the committed-secret grep test can stay maximally strict.
#
# Every `:?`-required compose variable is listed uncommented — `make deploy` fails fast
# on any missing one. Commented lines are optional knobs with their defaults shown.

# --- Langfuse stack secrets (compose `:?`-required) ---
BV_LANGFUSE_PG_PASSWORD=__set_me__
BV_LANGFUSE_CH_PASSWORD=__set_me__
BV_LANGFUSE_REDIS_PASSWORD=__set_me__
BV_LANGFUSE_MINIO_PASSWORD=__set_me__
BV_LANGFUSE_SALT=__set_me__
# 64 hex chars (openssl rand -hex 32):
BV_LANGFUSE_ENCRYPTION_KEY=__set_me__
BV_LANGFUSE_NEXTAUTH_SECRET=__set_me__
# Headless-init identity; the SAME keys below are what the init provisions, so probes
# authenticate with them on every fresh deploy (fresh volumes re-create identical keys).
BV_LANGFUSE_INIT_EMAIL=__set_me__
BV_LANGFUSE_INIT_PASSWORD=__set_me__
BV_LANGFUSE_SECRET_KEY=__set_me__
BV_LANGFUSE_PUBLIC_KEY=__set_me__
# BV_LANGFUSE_PORT=18321
# BV_LANGFUSE_HOST=127.0.0.1        # in-network prober sets langfuse-web
# BV_LANGFUSE_TELEMETRY=true        # airgap dual-scoring lever (P4 sets it per run)

# --- Opik stack secrets (compose `:?`-required) ---
BV_OPIK_MYSQL_PASSWORD=__set_me__
BV_OPIK_CH_PASSWORD=__set_me__
# Self-hosted Opik runs unauthenticated by default — leave the key unset unless the
# deployment enforces one (the client sends Authorization only when it is set).
# BV_OPIK_API_KEY=
# BV_OPIK_PORT=18322
# BV_OPIK_HOST=127.0.0.1            # in-network prober sets opik-frontend
# BV_OPIK_WORKSPACE=default
# BV_OPIK_USAGE_REPORT=true         # airgap dual-scoring lever (P4 sets it per run)

# --- Local judge (OpenAI-compatible; most servers accept any non-empty key) ---
BV_JUDGE_API_KEY=__set_me__
# BV_JUDGE_PORT=18323
# BV_JUDGE_HOST=127.0.0.1
# BV_JUDGE_MODEL=llama3.2:3b
# BV_JUDGE_CONTAINER_URL=http://bv-judge:11434/v1   # judge as seen from backend containers

# --- Optional knobs (defaults in config.yaml) ---
# BV_OP_TIMEOUT_SECONDS=30
# BV_PROBE_BUDGET_SECONDS=300
# BV_MODEL_PULL_SECONDS=3600        # judge model download budget (slow links: raise)
# BV_DOCKER_PROBE_SECONDS=30
# BV_NETWORK_OP_SECONDS=60
# BV_CONTAINER_LS_SECONDS=60
# BV_RETRY_MAX_ATTEMPTS=3
# BV_RETRY_BACKOFF_SECONDS=2
# BV_MIN_FREE_GB=20
# BV_CONTROL_ENDPOINT=http://127.0.0.1:1/
