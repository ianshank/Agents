# Environment Variables — langfuse-eval-harness
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Langfuse — required for langfuse dataset source, sink, and tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# BrainTrust — required for the braintrust result sink (SDK reads these directly).
# BRAINTRUST_API_URL overrides the default https://api.braintrust.dev for self-hosted stacks.
BRAINTRUST_API_KEY=
# BRAINTRUST_API_URL=https://api.braintrust.dev

# NVIDIA Nemotron — required for the openai judge with NVIDIA backend
NVIDIA_API_KEY=

# OpenAI — required for the openai judge with OpenAI backend
OPENAI_API_KEY=

# LM Studio / any OpenAI-compatible local endpoint (no key needed). The `model`
# target reads EVAL_BASE_URL; `openai`-judge YAML configs set base_url inline
# (e.g. config/lm_studio_eval.yaml).
# EVAL_BASE_URL=http://127.0.0.1:1234/v1

# Anthropic — required for the anthropic judge backend
ANTHROPIC_API_KEY=

# Arize Phoenix — optional tracing sink + phoenix_evals judge (SDK-optional;
# degrades to a no-op offline). PHOENIX_COLLECTOR_ENDPOINT is the OTLP collector;
# PHOENIX_API_KEY is only needed for an authenticated/hosted collector.
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# PHOENIX_API_KEY=

# Eval engine — parallel execution (default: sequential)
# MAX_WORKERS=1

# Output directory for sinks (json_file, future html_report)
# OUT_DIR=./out

# Path confinement (optional, recommended for shared/CI runners). Both are roots,
# not files: a config-supplied path must resolve inside the root or the run fails.
# DATA_ROOT confines dataset READS (jsonl/csv/parquet sources); OUTPUT_ROOT confines
# sink WRITES (json_file, html_file). They are deliberately separate variables — a
# read-only corpus named as DATA_ROOT must not thereby become a legal write target.
# Unset means unconfined, which is the historical behaviour and only logs a warning.
# DATA_ROOT=./data
# OUTPUT_ROOT=./out

# Modules an eval config's `callable` target may import (comma-separated prefixes).
# The `callable` target resolves "module:attribute" from config and CALLS it, so a
# config file is executable input. This allowlist is the operator's control over that,
# and it lives here rather than in the config precisely because the config is the
# untrusted side. UNSET MEANS DENY: leave it unset unless you use `callable` targets.
# Matching is on module boundaries, so `my_project` admits `my_project.targets` but
# never `my_project_evil`. Set it to * only for a local loop where you wrote every
# config yourself; that is logged at WARNING every time it is honoured.
# EVAL_HARNESS_CALLABLE_TARGET_ALLOWLIST=my_project

# Sampling rate for eval runs (0.0-1.0, default: 1.0)
# SAMPLE_RATE=1.0

# Judge score threshold (default: 0.6)
# JUDGE_THRESHOLD=0.6

# CLI timeout for E2E tests (seconds)
# E2E_CLI_TIMEOUT_SECONDS=300

# Calibrated merge gate (opt-in, requires audit labels)
# ENABLE_CALIBRATED_AUTOMERGE=
