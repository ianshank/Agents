# Eval-integrity protected paths.
#
# These files define the evaluation surface of the harness (feature ledger, gate
# thresholds, scorers, judges, validation scripts, the test suite, and CI). Changing
# them can silently weaken what the harness measures, so every change requires review
# by a CODEOWNER. This mirrors scripts/eval_protected_paths.py (the single source of
# truth) and the CI guard in scripts/check_protected_changes.py.

/features.yaml                  @ianshank
/features.schema.json           @ianshank
/architecture.yaml              @ianshank
/scripts/validations/           @ianshank
/config/                        @ianshank
/src/eval_harness/gating/       @ianshank
/src/eval_harness/scorers/      @ianshank
/src/eval_harness/judges/       @ianshank
/tests/                         @ianshank
/agent-core/tests/              @ianshank
/behavioral-regression/tests/   @ianshank
/flow-corpus/tests/             @ianshank
/flow-protocol/tests/           @ianshank
/claude-foundation/tests/       @ianshank
/.github/                       @ianshank

# Gate thresholds. `coverage-floors.yaml` pins each unit's minimum coverage floor and
# `scripts/check_coverage_floors.py` enforces it; the files below are where the floors are
# actually declared. Lowering one of these numbers weakens what CI proves, so it is a
# reviewed act like any other eval-integrity change.
/coverage-floors.yaml                        @ianshank
/pyproject.toml                              @ianshank
/scripts/quality-gate.sh                     @ianshank
/scripts/.coveragerc                         @ianshank
/agent-core/pyproject.toml                   @ianshank
/agent-core/scripts/quality-gate.sh          @ianshank
/behavioral-regression/pyproject.toml        @ianshank
/behavioral-regression/scripts/quality-gate.sh @ianshank
/flow-corpus/pyproject.toml                  @ianshank
/flow-corpus/scripts/quality-gate.sh         @ianshank
/flow-protocol/pyproject.toml                @ianshank
/flow-protocol/scripts/quality-gate.sh       @ianshank
/claude-foundation/pyproject.toml            @ianshank
/claude-foundation/scripts/quality-gate.sh   @ianshank

# The Makefiles that invoke the gates above. Pinning a coverage floor protects the
# number; every package's CI reaches that number through `make check`, so a gutted
# `check:` recipe disables the gate while every pinned value stays untouched.
/Makefile                                    @ianshank
/agent-core/Makefile                         @ianshank
/behavioral-regression/Makefile              @ianshank
/flow-corpus/Makefile                        @ianshank
/flow-protocol/Makefile                      @ianshank
/claude-foundation/Makefile                  @ianshank
